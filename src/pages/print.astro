---
import '@/styles/global.css';
import '@/styles/print.css';
import '@/styles/print-settings.css';
import { PrintApp } from '@/components/print/PrintApp';
import { parseCSV } from '@/utils/csvParser';
import { transformMenuData } from '@/utils/menuTransformer';

// Configuration from environment
const config = {
  csvUrl: import.meta.env.CSV_URL,
  currencySymbol: import.meta.env.CURRENCY_SYMBOL,
  currencyPosition: import.meta.env.CURRENCY_POSITION as 'before' | 'after',
  showDots: import.meta.env.SHOW_DOTS === 'true',
  headerTitle: import.meta.env.HEADER_TITLE,
};

// Fetch and parse menu data server-side
let menuData = [];
let error = false;

try {
  const response = await fetch(config.csvUrl);
  if (!response.ok) throw new Error('Failed to fetch CSV');

  const csvText = await response.text();
  const rows = parseCSV(csvText);
  menuData = transformMenuData(rows);
} catch (err) {
  console.error('Error loading menu:', err);
  error = true;
}
---

<!DOCTYPE html>
<html lang="fr" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{config.headerTitle} - Carte Imprimable</title>
    <meta name="description" content="Version imprimable de la carte des boissons" />
    <link href="https://fonts.cdnfonts.com/css/alexa-std" rel="stylesheet">
  </head>
  <body class="bg-gray-950 text-gray-100 min-h-screen">
    {error ? (
      <div class="flex items-center justify-center min-h-screen px-4">
        <div class="text-center max-w-md">
          <p class="text-red-400 text-lg mb-4">Erreur de chargement de la carte</p>
          <a
            href="/print"
            class="px-6 py-3 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors inline-block"
          >
            Réessayer
          </a>
        </div>
      </div>
    ) : (
      <PrintApp
        menuData={menuData}
        currencySymbol={config.currencySymbol}
        currencyPosition={config.currencyPosition}
        showDots={config.showDots}
        client:only="preact"
      />
    )}
  </body>
</html>
